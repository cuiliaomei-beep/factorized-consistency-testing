    "source": "def forward(self, x):\n        p = torch.randperm(5)\n        # Create a non-injective (overlapping) view of randperm \n        idx = torch.as_strided(p, (5,), (0,))\n        y = x[idx] + 1.0\n        x.index_put_((idx,), y, accumulate=False)\n        return x"
